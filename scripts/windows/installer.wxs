<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Scope="perUser" (Issue #341): the package installs into LocalAppData
       and edits the user's PATH only, so it must not default to a
       per-machine install that asks for elevation (UAC). -->
  <Package Name="zotero-cli"
           Manufacturer="Fabio Chicout"
           Version="$(var.Version)"
           Scope="perUser"
           UpgradeCode="524957e1-8559-4f7d-8b6b-4f9e3c9e9e9e">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="zotero-cli">
        <!-- The Environment row needs its own KeyPath; there's no single
             harvested file to hang it off (Issue #434: onedir has no one
             "the" executable file authored by hand anymore). A per-user
             registry value plays that role, as is standard for perUser
             PATH components. -->
        <Component Id="ZoteroCliPathEnv" Guid="d9c0e3a1-7c5b-4b1a-9a9a-9a9a9a9a9a9a">
          <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\[ProductName]" Name="PathAdded"
                         Type="integer" Value="1" KeyPath="yes" />
          <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="no" />
        </Component>
        <!-- Issue #405: the licence and third-party notices ship with the exe. -->
        <Component Id="ZoteroCliLicenses" Guid="43eda7b1-feff-4fae-a3cb-8a2e5627720a">
          <File Id="LicenseFile" Source="dist\LICENSE.txt" KeyPath="yes" />
          <File Id="ThirdPartyNotices" Source="dist\THIRD_PARTY_LICENSES.txt" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Issue #434: onedir replaces the single exe with zotero-cli.exe plus
         a `_internal\` support tree (dozens of files); WiX 5's Files element
         harvests the whole tree instead of hand-listing every DLL/data file,
         which would silently go stale as dependencies change. WiX 4.0.1 (the
         previous toolset version here) had no such bulk-harvesting element. -->
    <ComponentGroup Id="ZoteroCliFiles" Directory="INSTALLFOLDER" Source="dist\zotero-cli">
      <Files Include="**" />
    </ComponentGroup>

    <Feature Id="Main">
      <ComponentRef Id="ZoteroCliPathEnv" />
      <ComponentRef Id="ZoteroCliLicenses" />
      <ComponentGroupRef Id="ZoteroCliFiles" />
    </Feature>
  </Package>
</Wix>
